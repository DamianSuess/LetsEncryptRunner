{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build all projects",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "LetsEncryptRunner.slnx",
        "-maxcpucount",
        "-property:GenerateFullPaths=true"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
